{
  "functions": {
    "api/**/*": {
      "includeFiles": ["dist/index.html", "firebase-applet-config.json"]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/server"
    },
    {
      "source": "/events/(.*)",
      "destination": "/api/server"
    },
    {
      "source": "/news/(.*)",
      "destination": "/api/server"
    },
    {
      "source": "/diorama",
      "destination": "/api/server"
    }
  ]
}

{
  "functions": {
    "api/**/*": {
      "includeFiles": ["dist/index.html", "firebase-applet-config.json", "index.html"]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/server"
    },
    {
      "source": "/events/(.*)",
      "destination": "/api/server?ssrPath=/events/$1"
    },
    {
      "source": "/news/(.*)",
      "destination": "/api/server?ssrPath=/news/$1"
    },
    {
      "source": "/diorama",
      "destination": "/api/server?ssrPath=/diorama"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

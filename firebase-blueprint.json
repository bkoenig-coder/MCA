{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Event": {
      "title": "Event",
      "description": "Cultural event or workshop",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "titleEn": { "type": "string" },
        "titleMn": { "type": "string" },
        "description": { "type": "string" },
        "descriptionEn": { "type": "string" },
        "descriptionMn": { "type": "string" },
        "price": { "type": "number", "description": "Price in EUR cents" },
        "capacity": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "time": { "type": "string" },
        "location": { "type": "string" },
        "locationEn": { "type": "string" },
        "locationMn": { "type": "string" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string" },
        "categoryEn": { "type": "string" },
        "categoryMn": { "type": "string" },
        "whatsIncluded": { "type": "array", "items": { "type": "string" } },
        "registeredCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "price", "description", "date", "imageUrl", "createdAt"]
    },
    "Registration": {
      "title": "Registration",
      "description": "User registration for an event",
      "type": "object",
      "properties": {
        "eventId": { "type": "string" },
        "eventTitle": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "paid", "cancelled", "completed"] },
        "amount": { "type": "number" },
        "stripeSessionId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["eventId", "eventTitle", "userId", "userEmail", "name", "email", "status", "amount", "createdAt"]
    },
    "Post": {
      "title": "Post",
      "description": "Blog post or update",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "titleEn": { "type": "string" },
        "titleMn": { "type": "string" },
        "content": { "type": "string" },
        "contentEn": { "type": "string" },
        "contentMn": { "type": "string" },
        "imageUrl": { "type": "string" },
        "authorId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "authorId", "createdAt"]
    },
    "PageView": {
      "title": "PageView",
      "description": "Website page view analytics",
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" },
        "userAgent": { "type": "string" }
      },
      "required": ["path", "timestamp"]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "Artwork or photo in the gallery",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "titleEn": { "type": "string" },
        "titleMn": { "type": "string" },
        "artist": { "type": "string" },
        "artistEn": { "type": "string" },
        "artistMn": { "type": "string" },
        "year": { "type": "string" },
        "description": { "type": "string" },
        "descriptionEn": { "type": "string" },
        "descriptionMn": { "type": "string" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string" },
        "categoryEn": { "type": "string" },
        "categoryMn": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "imageUrl", "createdAt"]
    },
    "MembershipApplication": {
      "title": "MembershipApplication",
      "description": "User application for membership tiers (student, professional, institutional)",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "gender": { "type": "string" },
        "dob": { "type": "string" },
        "phone": { "type": "string" },
        "nationality": { "type": "string" },
        "tier": { "type": "string", "enum": ["student", "professional", "institutional"] },
        "age": { "type": "number" },
        "schoolOrUniversity": { "type": "string" },
        "studentIdNumber": { "type": "string" },
        "organizationName": { "type": "string" },
        "position": { "type": "string" },
        "websiteOrLinkedin": { "type": "string" },
        "statementOfPurpose": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userEmail", "firstName", "lastName", "tier", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/membership_applications/{applicationId}": {
      "schema": "MembershipApplication",
      "description": "User membership applications"
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "Event details"
    },
    "/registrations/{registrationId}": {
      "schema": "Registration",
      "description": "Event registrations"
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Blog posts"
    },
    "/analytics/{viewId}": {
      "schema": "PageView",
      "description": "Page view tracking"
    },
    "/gallery/{itemId}": {
      "schema": "GalleryItem",
      "description": "Gallery items"
    }
  }
}
